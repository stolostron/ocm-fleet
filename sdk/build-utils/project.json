{
  "name": "build-utils",
  "metadata": {
    "description": "Shared build helpers for web console plugins and UI assets."
  },
  "root": "sdk/build-utils",
  "sourceRoot": "sdk/build-utils/src",
  "projectType": "library",
  "tags": [
    "lang:typescript",
    "scope:ui",
    "type:lib",
    "type:js-project",
    "test:vitest"
  ],
  "targets": {
    "fmt": {},
    "verify": {},
    "fix": {},
    "fix:lint": {},
    "refresh:inputs": {},
    "check": {},
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc",
        "cwd": "sdk/build-utils"
      },
      "inputs": ["{projectRoot}/src/**/*", "{projectRoot}/tsconfig*.json"],
      "outputs": ["{projectRoot}/dist"]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["{projectRoot}/src/**/*.{ts,tsx}"]
      }
    },
    "test": {},
    "lint:format": {},
    "typecheck": {}
  }
}
