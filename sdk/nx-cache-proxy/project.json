{
  "name": "nx-cache-proxy",
  "metadata": {
    "description": "Nx remote cache proxy backed by MinIO."
  },
  "tags": ["lang:go"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "projects": ["ocm-fleet"], "target": "lint:go:config" }],
      "options": {
        "command": "../../bin/tools/golangci-lint run --config ../../.golangci.yaml --allow-serial-runners --path-mode=abs ./...",
        "cwd": "sdk/nx-cache-proxy",
        "env": { "GOWORK": "off" }
      },
      "cache": true,
      "inputs": ["goSource", "goLintConfig"],
      "outputs": []
    },
    "build": {
      "command": "cd sdk/nx-cache-proxy && go build -o ../../bin/nx-cache-proxy ./cmd/nx-cache-proxy/",
      "outputs": ["{workspaceRoot}/bin/nx-cache-proxy"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "GOTESTSUM_FORMAT=\"${GOTESTSUM_FORMAT:-pkgname-and-test-fails}\" go tool gotestsum --format-icons hivis --format-hide-empty-pkg -- -count=1 ./...",
        "cwd": "sdk/nx-cache-proxy"
      },
      "cache": false
    }
  }
}
