{
  "name": "node-plugin",
  "root": "sdk/node-plugin",
  "sourceRoot": "sdk/node-plugin/src",
  "projectType": "library",
  "tags": [
    "lang:typescript",
    "scope:ui",
    "type:lib",
    "visibility:private",
    "type:js-project",
    "test:vitest"
  ],
  "targets": {
    "fmt": {},
    "verify": {},
    "fix": {},
    "fix:lint": {},
    "refresh:inputs": {},
    "check": {},
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.json",
        "cwd": "sdk/node-plugin"
      },
      "inputs": ["{projectRoot}/src/**/*", "{projectRoot}/tsconfig*.json"],
      "outputs": ["{projectRoot}/dist"]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "{projectRoot}/src/**/*.ts",
          "{projectRoot}/fixtures/**/*.{js,mjs}"
        ]
      },
      "inputs": [
        "uiSource",
        "eslintConfig",
        "{projectRoot}/fixtures/**/*.{js,mjs}"
      ]
    },
    "lint:fix": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "{projectRoot}/src/**/*.ts",
          "{projectRoot}/fixtures/**/*.{js,mjs}"
        ],
        "fix": true
      },
      "inputs": [
        "uiSource",
        "eslintConfig",
        "{projectRoot}/fixtures/**/*.{js,mjs}"
      ]
    },
    "test": {},
    "fixture": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node fixtures/build.mjs",
        "cwd": "sdk/node-plugin"
      }
    },
    "lint:format": {},
    "typecheck": {}
  }
}
