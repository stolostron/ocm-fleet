{
  "name": "common",
  "metadata": {
    "description": "Shared types, utilities, and hooks for the web console and its plugins."
  },
  "root": "sdk/common",
  "sourceRoot": "sdk/common/src",
  "projectType": "library",
  "tags": [
    "lang:typescript",
    "scope:ui",
    "type:lib",
    "type:js-project",
    "test:vitest"
  ],
  "targets": {
    "fmt": {},
    "verify": {},
    "fix": {},
    "fix:lint": {},
    "refresh:inputs": {},
    "check": {},
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json && echo '{\"type\":\"module\"}' > dist/esm/package.json && node scripts/generate-dynamic-modules.mjs",
        "cwd": "sdk/common"
      },
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/tsconfig*.json",
        "typescriptConfig"
      ],
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": ["ocm-fleet:web:generate-icons"]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["{projectRoot}/src/**/*.{ts,tsx}"]
      }
    },
    "test": {},
    "lint:format": {},
    "typecheck": {
      "dependsOn": ["ocm-fleet:web:generate-icons"]
    }
  }
}
