{
  "name": "shell",
  "metadata": {
    "description": "Portable, UI-framework-neutral shell SDK scaffold."
  },
  "root": "sdk/shell",
  "sourceRoot": "sdk/shell/src",
  "projectType": "library",
  "tags": [
    "lang:typescript",
    "scope:ui",
    "type:lib",
    "type:js-project",
    "test:vitest"
  ],
  "targets": {
    "fmt": {},
    "verify": {},
    "fix": {},
    "fix:lint": {},
    "refresh:inputs": {},
    "check": {},
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json && echo '{\"type\":\"module\"}' > dist/esm/package.json",
        "cwd": "sdk/shell"
      },
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/tsconfig*.json",
        "typescriptConfig"
      ],
      "outputs": ["{projectRoot}/dist"]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["{projectRoot}/src/**/*.{ts,tsx}"]
      }
    },
    "test": {},
    "lint:format": {},
    "typecheck": {}
  }
}
