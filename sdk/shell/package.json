      "require": "./dist/cjs/index.js"
    }
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-router-dom": "^7.13.1"
  },
  "dependencies": {
    "@openshift/dynamic-plugin-sdk": "^9.1.0",
    "@scalprum/react-core": "^0.13.4",
    "fast-deep-equal": "^3.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@scalprum/core": "^0.10.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^26.1.0",
    "react-dom": "19.2.8"
  }
}
