{
  "name": "@ocm-fleet/shell",
  "description": "Portable shell SDK for OCM Fleet consoles.",
  "version": "0.0.0",
  "private": true,
  "sideEffects": false,
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": {
