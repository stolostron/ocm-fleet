# Dex shares the resource manager Pod network and is exposed at this host port.
OIDC_ISSUER_URL=http://localhost:5556/dex
OIDC_UI_CLIENT_ID=ocm-fleet-console
OIDC_UI_SCOPE=openid profile email groups audience:server:client_id:resource-manager
# The API access token must contain this audience.
OIDC_RESOURCE_AUDIENCE=resource-manager
# Signing-key enrollment uses an ID token with this audience.
OIDC_KEY_ENROLLMENT_AUDIENCE=resource-manager-signing
# The demo user can read the API. For signing workflows, configure a real
# signing-key registry identity or a public-key claim supplied by your issuer.
# Registry mapping and a public-key claim are mutually exclusive.
KEY_REGISTRY_ID=
KEY_REGISTRY_SUBJECT_EXPR=
PUBLIC_KEY_CLAIM_EXPR=
OCM_RM_LOG_LEVEL=info
OCM_RM_SERVER_ADDONS=kubernetes
