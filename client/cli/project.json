{
  "name": "cli",
  "metadata": {
    "description": "Fleetctl command-line interface for OCM Fleet."
  },
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "client/cli/src",
  "projectType": "application",
  "tags": ["lang:typescript", "scope:cli"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["typecheck"],
      "outputs": ["{projectRoot}/bin", "{workspaceRoot}/bin/fleetctl"],
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/rspack.config.ts"
      ],
      "options": {
        "command": "NODE_ENV=production rspack --config rspack.config.ts && chmod +x bin/fleetctl && mkdir -p ../../bin && ln -sfn ../client/cli/bin/fleetctl ../../bin/fleetctl",
        "cwd": "client/cli"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/vitest.config.ts",
        "{projectRoot}/rspack.config.ts",
        "{projectRoot}/tsconfig.json",
        "{workspaceRoot}/tsconfig.json"
      ],
      "options": {
        "command": "vitest run --config vitest.config.ts",
        "cwd": "client/cli"
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["build", "node-plugin:build"],
      "inputs": [
        "{projectRoot}/e2e/**/*",
        "{projectRoot}/src/app.tsx",
        "{projectRoot}/rspack.config.ts",
        "{projectRoot}/package.json",
        "{workspaceRoot}/package-lock.json",
        "{workspaceRoot}/sdk/node-plugin/src/**/*",
        "{workspaceRoot}/sdk/node-plugin/package.json"
      ],
      "options": {
        "command": "node e2e/run.mjs",
        "cwd": "client/cli"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/tsconfig.json",
        "{workspaceRoot}/tsconfig.json"
      ],
      "options": {
        "command": "tsc --noEmit -p tsconfig.json",
        "cwd": "client/cli"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "inputs": ["uiSource", "eslintConfig", "{projectRoot}/e2e/**/*"],
      "options": {
        "command": "eslint \"client/cli/src/**/*.{ts,tsx}\" \"client/cli/e2e/**/*.{js,mjs,tsx}\"",
        "cwd": "."
      }
    }
  }
}
