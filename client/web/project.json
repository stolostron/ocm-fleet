{
  "name": "web",
  "metadata": {
    "description": "OCM Fleet web console with navigation, authentication, and plugin hosting.",
    "additionalAgentInstruction": "See docs/ui/AGENTS.md for agent instructions."
  },
  "root": "client/web",
  "sourceRoot": "client/web/src",
  "projectType": "application",
  "tags": ["scope:ui", "type:app", "type:js-project", "test:vitest"],
  "implicitDependencies": ["plugins", "@ocm-fleet/kind-plugin"],
  "targets": {
    "fmt": {},
    "verify": {},
    "fix": {},
    "fix:lint": {},
    "refresh:inputs": {},
    "check": {},
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rspack build",
        "cwd": "client/web"
      },
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/rspack.config.*",
        "{projectRoot}/tsconfig*.json"
      ],
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": ["common:build"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/dev.mjs"
      },
      "cache": false
    },
    "dev:watch": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/dev.mjs --watch"
      },
      "cache": false
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["{projectRoot}/src/**/*.{ts,tsx}"]
      }
    },
    "lint:fix": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["{projectRoot}/src/**/*.{ts,tsx}"],
        "fix": true
      }
    },
    "test:ct": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright test",
        "cwd": "client/web"
      },
      "dependsOn": ["ocm-fleet:web:generate-icons"]
    },
    "lint:css": {
      "executor": "nx:run-commands",
      "options": {
        "command": "stylelint 'src/**/*.{css,scss}' --config ../../stylelint.config.mjs --ignore-pattern '**/node_modules/**' --ignore-pattern '**/dist/**'",
        "cwd": "client/web"
      }
    },
    "fix:css": {},
    "test": {},
    "lint:format": {}
  }
}
