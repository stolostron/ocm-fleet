{
  "name": "proto",
  "metadata": {
    "description": "OCM Fleet API protocol definitions and code generation."
  },
  "root": "proto",
  "projectType": "library",
  "tags": ["lang:proto", "scope:api"],
  "targets": {
    "fmt": {
      "executor": "nx:run-commands",
      "options": {
        "forwardAllArgs": false,
        "env": {
          "NX_DAEMON": "false"
        },
        "commands": [
          "buf format --write proto",
          "npx nx run proto:refresh:inputs"
        ],
        "parallel": false
      },
      "cache": false
    },
    "verify": {},
    "fix": {},
    "fix:lint": {
      "executor": "nx:noop",
      "cache": false
    },
    "refresh:inputs": {},
    "check": {},
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "forwardAllArgs": false,
        "env": {
          "NX_DAEMON": "false"
        },
        "commands": ["buf format --diff --exit-code proto", "buf lint"],
        "parallel": false
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*.proto",
        "{workspaceRoot}/buf.yaml",
        "{workspaceRoot}/buf.lock",
        {
          "runtime": "buf --version"
        }
      ],
      "outputs": []
    },
    "generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "buf generate --path proto/ocm"
      },
      "inputs": [
        "{projectRoot}/**/*.proto",
        "{workspaceRoot}/buf.yaml",
        "{workspaceRoot}/buf.gen.yaml"
      ],
      "outputs": ["{workspaceRoot}/server/gen"]
    }
  }
}
