{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": true,
  "tui": {
    "enabled": false
  },
  "plugins": [
    {
      "plugin": "@nx/docker",
      "options": {
        "buildTarget": {
          "name": "docker:build"
        },
        "runTarget": {
          "name": "docker:run"
        }
      }
    },
    {
      "plugin": "@nx/playwright/plugin",
      "options": {
        "targetName": "test:ct",
        "ciTargetName": "test:ct:ci"
      }
    }
  ],
  "namedInputs": {
    "goSource": ["{projectRoot}/**/*"],
    "goLintTool": [
      "{workspaceRoot}/tools/golangci-lint/**/*",
      "{workspaceRoot}/tools/golangci-lint.mjs",
      {
        "runtime": "node tools/golangci-lint.mjs env"
      }
    ],
    "goLintConfig": [
      "{workspaceRoot}/.golangci.yaml",
      "goLintTool",
      {
        "runtime": "go env GOVERSION GOOS GOARCH CGO_ENABLED GOFLAGS GOEXPERIMENT GOTOOLCHAIN CC CXX CGO_CFLAGS CGO_CPPFLAGS CGO_CXXFLAGS CGO_LDFLAGS"
      }
    ],
    "uiSource": [
      "{projectRoot}/src/**/*.{ts,tsx,js,jsx}",
      "{projectRoot}/tsconfig*.json"
    ],
    "uiStyles": ["{projectRoot}/src/**/*.{css,scss}"],
    "eslintConfig": ["{workspaceRoot}/eslint.config.mjs"]
  },
  "targetDefaults": {
    "build": {
      "cache": true
    },
    "test": {
      "cache": true
    },
    "lint": {
      "cache": true,
      "inputs": ["uiSource", "eslintConfig"]
    },
    "lint:css": {
      "cache": true,
      "inputs": ["uiStyles"]
    },
    "test:ct": {
      "cache": true,
      "dependsOn": ["^build"]
    }
  }
}
